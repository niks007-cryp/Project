# Local AI Clipper — Environment Configuration Example
#
# Copy this file to .env and fill in your values.
# NEVER commit the real .env — only this .env.example.
#
# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────────────────────
CLIPPER_ENVIRONMENT=development
# Options: development | preview | production

# ──────────────────────────────────────────────────────────────────────────────
# LOCAL PATHS (Local Processing Engine only — not used in Vercel deployment)
# ──────────────────────────────────────────────────────────────────────────────
CLIPPER_WORKSPACE_DIR=
# Absolute path to your local workspace (e.g. N:\local-ai-clipper)
# Leave blank to use the default (project root)

CLIPPER_JOBS_DIR=
# Absolute path to job manifest storage
# Leave blank to use default: <workspace>/jobs

CLIPPER_MODELS_DIR=
# Absolute path to local AI model weights
# Leave blank to use default: <workspace>/models

# ──────────────────────────────────────────────────────────────────────────────
# BYOK — USER-CONTROLLED AI PROVIDER CREDENTIALS
# ──────────────────────────────────────────────────────────────────────────────
# These are NOT deployment secrets.
# User API keys must be entered through the application UI or CLI:
#   clipper provider set gemini --key <YOUR_KEY>
#
# DO NOT put real API keys here.
# DO NOT put real API keys in NEXT_PUBLIC_* variables.
# DO NOT commit API keys to Git.
#
# Provider configuration is stored encrypted on the local machine via DPAPI.

AI_PROVIDER=
# User's selected provider: gemini | openai | openrouter | local

AI_MODEL=
# e.g. gemini-1.5-pro | gpt-4o | mistral-7b

AI_API_ENDPOINT=
# Optional custom endpoint URL (for OpenRouter, Ollama, etc.)

# ──────────────────────────────────────────────────────────────────────────────
# WEB SERVER
# ──────────────────────────────────────────────────────────────────────────────
CLIPPER_WEB_HOST=127.0.0.1
CLIPPER_WEB_PORT=3000
# Local web control panel bind address and port

# ──────────────────────────────────────────────────────────────────────────────
# VERCEL / DEPLOYMENT (Control Plane)
# ──────────────────────────────────────────────────────────────────────────────
# Set these in Vercel's environment variable dashboard — NOT here.
#
# DEPLOYMENT_ENV=production
# WORKER_API_URL=          # URL of the local worker endpoint (if exposing remotely)
# WORKER_API_TOKEN=        # Optional: shared secret for worker authentication

# ──────────────────────────────────────────────────────────────────────────────
# ASR / TRANSCRIPTION
# ──────────────────────────────────────────────────────────────────────────────
CLIPPER_ASR_MODEL=tiny
# Default Whisper model size: tiny | base | small | medium | large-v3

CLIPPER_ASR_DEVICE=auto
# Execution device: auto | cpu | cuda

CLIPPER_ASR_COMPUTE_TYPE=auto
# Precision: auto | int8 | float16 | float32

# ──────────────────────────────────────────────────────────────────────────────
# FFMPEG
# ──────────────────────────────────────────────────────────────────────────────
CLIPPER_FFMPEG_PATH=
# Absolute path to ffmpeg executable
# Leave blank to use system PATH or .bin/ffmpeg.exe

CLIPPER_FFPROBE_PATH=
# Absolute path to ffprobe executable

# ──────────────────────────────────────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────────────────────────────────────
CLIPPER_LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR

CLIPPER_LOG_FORMAT=json
# Options: json | text
